[Unit]
Description=Trovify: caza diaria de lunes a sábado a las 06:30 (hora de Colombia)

[Timer]
OnCalendar=Mon..Sat *-*-* 06:30:00 America/Bogota
# Persistent=true: si a las 06:30 el equipo (WSL) estaba apagado, la caza se lanza al arrancar,
# aunque sea otro día (un sábado perdido puede salir el domingo) o mientras tienes tu sesión abierta;
# el presupuesto del día es compartido, así que nunca se pasa del tope.
Persistent=true
Unit=trovify-caza.service

[Install]
WantedBy=timers.target
